# Markdown Previewer Development Environment Variables

# --- Core Application Settings ---

# Port for the development server to run on.
# Default for Create React App is 3000, but can be overridden here.
PORT=3000

# --- API Endpoints (if applicable) ---

# Base URL for any backend API calls this application might make.
# For example, if markdown content were to be saved or loaded from a database.
# In this project, it's primarily client-side, but good practice to include for future expansion.
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1

# --- Application Specific Settings ---

# Default markdown content to pre-populate the editor with during development.
# This helps in quickly testing the previewer with some initial text.
REACT_APP_DEFAULT_MARKDOWN_CONTENT="# Welcome to Markdown Previewer!\n\nThis is a real-time markdown editor built with React.\n\n## Features\n\n*   **Live Preview**: See your markdown rendered instantly.\n*   **GitHub Flavored Markdown**: Supports common markdown syntax.\n\n### How to Use\n\nStart typing markdown in the editor on the left, and watch it render on the right!\n\n```javascript\n// Example code block\nconst greeting = 'Hello, World!';\nconsole.log(greeting);\n```\n\n- List item 1\n- List item 2\n\n[Visit our GitHub](https://github.com/your-org/markdown-previewer)\n\n> Blockquotes are also supported.\n\n**Bold text**, *italic text*, and `inline code`."

# --- Cross-Project Integration Settings ---

# Base URL for the Interactive Portfolio Website service.
# This could be used if the Markdown Previewer needed to link to or push content to the portfolio.
REACT_APP_PORTFOLIO_SERVICE_URL=http://localhost:3001

# Base URL for the Todo App service.
# This could be used if the Markdown Previewer needed to integrate with the Todo App,
# e.g., for adding markdown notes to a todo item.
REACT_APP_TODO_SERVICE_URL=http://localhost:3002