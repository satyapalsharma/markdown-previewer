# .env.local - Local environment variables for the Markdown Previewer project.
# These variables are used during local development and are not committed to version control.
# For production, these values would be managed by your hosting provider or CI/CD pipeline.

# --- Application Configuration ---
# Publicly accessible variables must be prefixed with NEXT_PUBLIC_.
# These are exposed to the browser and can be accessed in client-side code.

# Application name for display purposes (e.g., in headers, titles).
NEXT_PUBLIC_APP_NAME="Markdown Previewer"

# Default content to load in the editor when the application starts.
# This provides an initial example for the user.
NEXT_PUBLIC_DEFAULT_MARKDOWN_CONTENT="# Welcome to the Markdown Previewer!\n\nThis is a real-time **Markdown Previewer** built with React and Next.js.\n\n## How to Use\n\n1.  Type your Markdown syntax in the editor on the left.\n2.  See the rendered HTML output instantly on the right.\n\n### Features\n\n-   Live preview\n-   Supports common Markdown elements (headers, lists, links, code blocks)\n\n```javascript\n// Example code block\nfunction greet(name) {\n  console.log(`Hello, ${name}!`);\n}\n\ngreet('World');\n```\n\nFeel free to experiment with different Markdown elements!\n\n[Visit the Project Repository](https://github.com/your-org/markdown-previewer)"

# --- API Endpoints (Simulated Microservices / Future Expansion) ---
# Even if this project primarily uses client-side parsing, these variables
# demonstrate how external services could be integrated or linked.

# Base URL for a potential backend API gateway or service for this application.
# This could be used for features like saving/loading markdown, user authentication,
# or if markdown parsing were offloaded to a dedicated microservice.
# Uncomment and configure if a backend API is introduced.
# NEXT_PUBLIC_API_BASE_URL="http://localhost:8080/api/v1"

# --- Cross-Project Integration (Recipe Finder Service) ---
# Variables to facilitate integration or linking with other services in our ecosystem.
# This demonstrates an interconnected microservice architecture.

# Base URL for the Recipe Finder application/service.
# This could be used for navigation links, embedding components, or making API calls
# if this Markdown Previewer needed to interact with the Recipe Finder service.
NEXT_PUBLIC_RECIPE_FINDER_SERVICE_URL="http://localhost:3001" # Assuming Recipe Finder runs on port 3001

# --- Development Server Configuration ---
# These variables are typically used by the Next.js development server.

# Port on which the Next.js development server will run.
# If not specified, Next.js defaults to 3000.
# PORT=3000